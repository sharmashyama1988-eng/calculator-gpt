{
  "buildCommand": "npm install",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "express",
  "functions": {
    "index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "env": {
    "OPENROUTER_API_KEY": {
      "description": "Your OpenRouter API key from https://openrouter.ai",
      "required": true
    },
    "NODE_ENV": {
      "default": "production"
    },
    "PORT": {
      "default": "3000"
    }
  }
}
